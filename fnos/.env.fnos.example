# ─────────────────────────────────────────────────────────────
# 云微 · fnOS 部署环境变量模板（本 fork 专用）
#
# 用法（Compose 直跑，推荐先用这条，fpk 之前的最短可用路径）：
#   1. fnOS「Docker → Compose 项目 → 创建项目」，把仓库根目录
#      docker-compose.yml 的内容粘贴进去；
#   2. 项目环境变量按本文件填写（或把本文件存为项目旁的 .env）；
#   3. 前提：先在 fork 仓库发布一个 vX.Y.Z Release，让 GitHub Actions
#      把 ghcr.io/keepon-online/{woc-panel,wechat-on-cloud} 推出去
#      （fork 的 Actions 页需手动启用一次；workflow 会自动用仓库 owner 做命名空间）。
#
# 部署后在 fnOS「Docker → 镜像」里手动预拉一次
#   ghcr.io/keepon-online/wechat-on-cloud:<WOC_VERSION>
# —— fnOS 内置的 Docker Hub 加速不覆盖面板（经 docker.sock）触发的拉取，
#   镜像先到本地后，面板新建实例直接复用、不再联网拉取。
# ─────────────────────────────────────────────────────────────

# ── 必改 ─────────────────────────────────────────────────────
# 管理员密码（默认 wechat 必须换掉）
WOC_PASSWORD=change-me

# ── 镜像源与版本 ─────────────────────────────────────────────
# 镜像源前缀：默认本 fork 的 GHCR；拉不动换南大反代；想跑上游官方版换 docker.io/gloridust
WOC_IMAGE_PREFIX=ghcr.io/keepon-online
#WOC_IMAGE_PREFIX=ghcr.nju.edu.cn/keepon-online
#WOC_IMAGE_PREFIX=docker.io/gloridust
# 版本：钉住自己发布的 tag 升级可控；latest = 跟随最新 Release
WOC_VERSION=latest

# ── 对外服务 ─────────────────────────────────────────────────
WOC_HTTP_PORT=36080
# 套 HTTPS 反代部署时把对外域名加进来（DNS-rebinding 白名单，默认放行私网）
PANEL_ALLOWED_HOSTS=
# 反代不在本机（如跑在路由器上）时填其地址，登录限速按真实来源计数
WOC_TRUSTED_PROXIES=

# ── 数据落盘 ─────────────────────────────────────────────────
# 对齐 fnOS 上实际拥有数据目录的用户（SSH 进去 id -u / id -g 查），避免权限错乱
WOC_PUID=1000
WOC_PGID=1000
# 实例数据目录：强烈建议指到共享目录（如 /vol1/1000/woc），微信收到的文件在
# 飞牛文件管理里直接可见、也方便放大容量盘；留空 = Docker 数据卷（落在系统盘）
WOC_DATA_ROOT=
# 登录会话时长（天），调小更安全、调大更省事
WOC_SESSION_DAYS=30

# ── 性能 ─────────────────────────────────────────────────────
# GPU 硬件编码：fnOS 物理机 + Intel 核显 → 填 1（面板自动探测 /dev/dri 并映射进实例，
# 60FPS 高流畅档的编码压力大幅卸到硬编）；虚拟机 / 无核显 / 不确定 → 留空（软件渲染）
WOC_ENABLE_GPU=
# 时区
WOC_TZ=Asia/Shanghai

# ── 稳定性（默认值即推荐值，按需调整）───────────────────────
# 实例内存看门狗（MiB）：soft = 超过且无人使用时柔和自愈；hard = 超过即强制重启防 OOM
WOC_INSTANCE_MEM_SOFT_MB=1500
WOC_INSTANCE_MEM_HARD_MB=2500
WOC_WATCHDOG_INTERVAL_SEC=300
# 桌面连接反复无应答（KasmVNC 卡死）时自动重启实例；0 = 只断开记日志
WOC_STUCK_HEAL=1
# 设备伪装（os-release 伪装 deepin，防风控），默认开
WOC_SPOOF_OS=1
# 面板拉实例镜像的“无进度”超时（分钟），超时快速失败而非无限转圈
WOC_PULL_STALL_MIN=5

# ── 可选（默认留空即可）──────────────────────────────────────
# 摄像头直通：逗号分隔宿主视频设备；留空 = 自动探测（fnOS 需先加载 v4l2loopback）
WOC_VIDEO_DEVICES=
# 宿主内核禁用 IPv6 时才需要设 1（面板会自动检测，一般留空）
WOC_DISABLE_IPV6=
# 实例内存上限（GiB），0/留空 = 不限制
WOC_INSTANCE_MEM_GB=
